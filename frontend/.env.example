# WalletConnect project ID — create one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Deployed contract address (set after running `make deploy-sepolia`)
NEXT_PUBLIC_CONTRACT_ADDRESS_84532=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CONTRACT_ADDRESS_8453=0x0000000000000000000000000000000000000000

# Optional: custom RPC URLs
# NEXT_PUBLIC_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
# NEXT_PUBLIC_RPC_URL_BASE=https://mainnet.base.org
