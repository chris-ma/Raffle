# ─── Database (Turso — free at turso.tech) ────────────────────────────────────
# 1. turso auth signup
# 2. turso db create raffle-app
# 3. turso db show raffle-app  (copy the URL)
# 4. turso db tokens create raffle-app  (copy the token)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# ─── Admin ────────────────────────────────────────────────────────────────────
# Choose any strong secret — you'll enter this in the app to unlock admin actions
ADMIN_SECRET=choose-a-strong-secret-here

# ─── Stripe (optional — only required for paid-ticket raffles) ─────────────────
# Create a free account at stripe.com — test mode costs nothing
# Use test card 4242 4242 4242 4242 / any future date / any CVC
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
